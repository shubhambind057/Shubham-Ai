rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLanguage(lang) {
      return lang in ['HINGLISH', 'HINDI', 'ENGLISH'];
    }

    function isValidPackageFormat(fmt) {
      return fmt in ['DUAL', 'SHORT', 'LONG'];
    }

    function isValidPreferenceProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidLanguage(data.defaultLanguage) &&
             isValidPackageFormat(data.defaultPackageFormat) &&
             data.memoryNotes is list && data.memoryNotes.size() <= 40 &&
             (data.memoryNotes.size() == 0 || data.memoryNotes[0] is string) &&
             data.backendProxyUrl is string && data.backendProxyUrl.size() <= 500 &&
             data.automationEnabled is bool &&
             data.automationHour is int && data.automationHour >= 0 && data.automationHour <= 23 &&
             data.automationMinute is int && data.automationMinute >= 0 && data.automationMinute <= 59 &&
             data.automationBeat is string && data.automationBeat.size() <= 80 &&
             (!('economyModeEnabled' in data) || data.economyModeEnabled is bool) &&
             (!('chatWebSearchDefault' in data) || data.chatWebSearchDefault is bool) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidChatMessage(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.threadId is string && data.threadId.size() >= 1 && data.threadId.size() <= 128 &&
             data.role in ['user', 'assistant'] &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 20000 &&
             isValidLanguage(data.language) &&
             data.citations is list && data.citations.size() <= 20 &&
             (data.citations.size() == 0 || data.citations[0] is map) &&
             data.certaintyTag in ['VERIFIED', 'MIXED', 'OPINION', 'UNCERTAIN', 'USER'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStudioProject(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.topicTitle is string && data.topicTitle.size() >= 1 && data.topicTitle.size() <= 300 &&
             data.categoryBeat is string && data.categoryBeat.size() >= 1 && data.categoryBeat.size() <= 80 &&
             isValidLanguage(data.language) &&
             isValidPackageFormat(data.packageFormat) &&
             data.angle is string && data.angle.size() <= 1500 &&
             data.hook is string && data.hook.size() <= 1500 &&
             data.whyCoverNow is string && data.whyCoverNow.size() <= 2000 &&
             data.stage in ['DISCOVERED', 'TOPIC_APPROVED', 'IN_PRODUCTION', 'FINAL_APPROVED', 'EXPORTED'] &&
             data.topicApproved is bool &&
             data.finalApproved is bool &&
             data.verifiedFacts is list && data.verifiedFacts.size() <= 40 &&
             (data.verifiedFacts.size() == 0 || data.verifiedFacts[0] is map) &&
             data.disputedClaims is list && data.disputedClaims.size() <= 25 &&
             (data.disputedClaims.size() == 0 || data.disputedClaims[0] is string) &&
             data.assumptions is list && data.assumptions.size() <= 25 &&
             (data.assumptions.size() == 0 || data.assumptions[0] is string) &&
             data.shortScript is string && data.shortScript.size() <= 20000 &&
             data.longScript is string && data.longScript.size() <= 60000 &&
             data.visualDirections is string && data.visualDirections.size() <= 25000 &&
             data.onScreenText is list && data.onScreenText.size() <= 50 &&
             (data.onScreenText.size() == 0 || data.onScreenText[0] is string) &&
             (!('titleOptions' in data) || (data.titleOptions is list && data.titleOptions.size() <= 15)) &&
             (!('thumbnailConcepts' in data) || (data.thumbnailConcepts is list && data.thumbnailConcepts.size() <= 15)) &&
             (!('descriptionAndChapters' in data) || (data.descriptionAndChapters is string && data.descriptionAndChapters.size() <= 15000)) &&
             (!('projectOverview' in data) || data.projectOverview is map) &&
             (!('storyStructure' in data) || data.storyStructure is map) &&
             (!('blueprintScenes' in data) || (data.blueprintScenes is list && data.blueprintScenes.size() <= 40)) &&
             data.footageAssets is list && data.footageAssets.size() <= 40 &&
             (data.footageAssets.size() == 0 || data.footageAssets[0] is map) &&
             data.voiceoverVoice is string && data.voiceoverVoice.size() <= 80 &&
             data.voiceoverStatus in ['NOT_GENERATED', 'GENERATED_LOCAL', 'TTS_PREVIEW_ONLY'] &&
             data.voiceoverLocalPath is string && data.voiceoverLocalPath.size() <= 500 &&
             (!('voiceoverDirectionNotes' in data) || (data.voiceoverDirectionNotes is string && data.voiceoverDirectionNotes.size() <= 15000)) &&
             data.subtitlesSrt is string && data.subtitlesSrt.size() <= 40000 &&
             data.capcutPlan is string && data.capcutPlan.size() <= 35000 &&
             data.capcutChecklist is list && data.capcutChecklist.size() <= 30 &&
             (data.capcutChecklist.size() == 0 || data.capcutChecklist[0] is map) &&
             (!('auditChecklist' in data) || (data.auditChecklist is list && data.auditChecklist.size() <= 25)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAutomationRun(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.triggerType in ['SCHEDULED', 'MANUAL'] &&
             data.status in ['COMPLETED', 'RETRYING', 'FAILED'] &&
             data.attemptCount is int && data.attemptCount >= 0 && data.attemptCount <= 10 &&
             data.summary is string && data.summary.size() <= 2000 &&
             data.projectId is string && data.projectId.size() <= 128 &&
             data.errorMessage is string && data.errorMessage.size() <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/preferences/{prefId} {
      allow get: if isOwner(userId) && isValidId(prefId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(prefId) &&
                       incoming().keys().hasAll([
                         'userId', 'defaultLanguage', 'defaultPackageFormat', 'memoryNotes',
                         'backendProxyUrl', 'automationEnabled', 'automationHour',
                         'automationMinute', 'automationBeat', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'defaultLanguage', 'defaultPackageFormat', 'memoryNotes',
                         'backendProxyUrl', 'automationEnabled', 'automationHour',
                         'automationMinute', 'automationBeat', 'economyModeEnabled',
                         'chatWebSearchDefault', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidPreferenceProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(prefId) &&
                       isValidPreferenceProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'defaultLanguage', 'defaultPackageFormat', 'memoryNotes',
                         'backendProxyUrl', 'automationEnabled', 'automationHour',
                         'automationMinute', 'automationBeat', 'economyModeEnabled',
                         'chatWebSearchDefault', 'updatedAt'
                       ]);
      allow delete: if isOwner(userId) && isValidId(prefId);
    }

    match /users/{userId}/chatMessages/{messageId} {
      allow get: if isOwner(userId) && isValidId(messageId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(messageId) &&
                       incoming().keys().hasAll([
                         'userId', 'threadId', 'role', 'content', 'language',
                         'citations', 'certaintyTag', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'threadId', 'role', 'content', 'language',
                         'citations', 'certaintyTag', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidChatMessage(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(messageId) &&
                       isValidChatMessage(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'content', 'citations', 'certaintyTag', 'updatedAt'
                       ]);
      allow delete: if isOwner(userId) && isValidId(messageId);
    }

    match /users/{userId}/studioProjects/{projectId} {
      allow get: if isOwner(userId) && isValidId(projectId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(projectId) &&
                       incoming().keys().hasAll([
                         'userId', 'topicTitle', 'categoryBeat', 'language', 'packageFormat',
                         'angle', 'hook', 'whyCoverNow', 'stage', 'topicApproved', 'finalApproved',
                         'verifiedFacts', 'disputedClaims', 'assumptions', 'shortScript',
                         'longScript', 'visualDirections', 'onScreenText', 'footageAssets',
                         'voiceoverVoice', 'voiceoverStatus', 'voiceoverLocalPath',
                         'subtitlesSrt', 'capcutPlan', 'capcutChecklist', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'topicTitle', 'categoryBeat', 'language', 'packageFormat',
                         'angle', 'hook', 'whyCoverNow', 'stage', 'topicApproved', 'finalApproved',
                         'verifiedFacts', 'disputedClaims', 'assumptions', 'shortScript',
                         'longScript', 'visualDirections', 'onScreenText',
                         'titleOptions', 'thumbnailConcepts', 'descriptionAndChapters',
                         'projectOverview', 'storyStructure', 'blueprintScenes',
                         'footageAssets', 'voiceoverVoice', 'voiceoverStatus', 'voiceoverLocalPath',
                         'voiceoverDirectionNotes', 'subtitlesSrt', 'capcutPlan',
                         'capcutChecklist', 'auditChecklist', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidStudioProject(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(projectId) &&
                       isValidStudioProject(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'topicTitle', 'categoryBeat', 'language', 'packageFormat',
                         'angle', 'hook', 'whyCoverNow', 'stage', 'topicApproved', 'finalApproved',
                         'verifiedFacts', 'disputedClaims', 'assumptions', 'shortScript',
                         'longScript', 'visualDirections', 'onScreenText',
                         'titleOptions', 'thumbnailConcepts', 'descriptionAndChapters',
                         'projectOverview', 'storyStructure', 'blueprintScenes',
                         'footageAssets', 'voiceoverVoice', 'voiceoverStatus', 'voiceoverLocalPath',
                         'voiceoverDirectionNotes', 'subtitlesSrt', 'capcutPlan',
                         'capcutChecklist', 'auditChecklist', 'updatedAt'
                       ]);
      allow delete: if isOwner(userId) && isValidId(projectId);
    }

    match /users/{userId}/automationRuns/{runId} {
      allow get: if isOwner(userId) && isValidId(runId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(runId) &&
                       incoming().keys().hasAll([
                         'userId', 'triggerType', 'status', 'attemptCount',
                         'summary', 'projectId', 'errorMessage', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'triggerType', 'status', 'attemptCount',
                         'summary', 'projectId', 'errorMessage', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidAutomationRun(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(runId) &&
                       isValidAutomationRun(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'attemptCount', 'summary', 'projectId', 'errorMessage', 'updatedAt'
                       ]);
      allow delete: if isOwner(userId) && isValidId(runId);
    }
  }
}
